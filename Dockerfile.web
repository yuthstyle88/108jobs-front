# ---- deps (cache layer) ----
FROM node:20-alpine AS deps
WORKDIR /app
# บางโปรเจ็กต์ต้องใช้ sharp → ต้องมี libc6-compat
RUN apk add --no-cache libc6-compat
COPY package*.json ./
RUN npm ci

# ---- builder ----
FROM node:20-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# ---------- สำคัญ ----------
# NEXT_PUBLIC_* เป็นค่าที่ฝังตอน build เท่านั้น
# ถ้าต้องการเปลี่ยน environment ต้อง build ใหม่หรือใช้วิธี inject runtime (ต้องแก้โค้ดเพิ่ม)
# เลยใส่เป็น --build-arg เพื่อความชัดเจน
ARG NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL:-https://api-staging.108jobs.com}

# (ถ้ามี .env.production จะถูกอ่านด้วย)
RUN npm run build

# ---- runner (Next standalone) ----
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
# Server-side API base (runtime). Override with `-e API_INTERNAL_URL=...` or compose.
# Default to host.docker.internal for macOS/Windows; works on Linux with `--add-host=host.docker.internal:host-gateway`.
ENV API_INTERNAL_URL=http://host.docker.internal:8532

# ไฟล์สำหรับโหมด standalone
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/static ./.next/static

RUN mkdir -p /app/.next/cache \
 && chown -R node:node /app

# ความปลอดภัยเล็กน้อย
USER node

# healthcheck ง่าย ๆ
HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:'+(process.env.PORT||3000), r=>{if(r.statusCode!==200)process.exit(1)}).on('error',()=>process.exit(1))"

EXPOSE 3000
CMD ["node", "server.js"]